{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/mvp_contract.schema.json",
  "title": "PM Prototype OS MVP Contract",
  "type": "object",
  "required": [
    "contract_version",
    "mvp_id",
    "title",
    "owner",
    "created_at",
    "hypothesis",
    "user",
    "scope",
    "data",
    "acceptance",
    "technical_decisions",
    "quality_gate",
    "demo",
    "decision",
    "result"
  ],
  "properties": {
    "contract_version": {"type": "string"},
    "mvp_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date"},
    "hypothesis": {
      "type": "object",
      "required": ["statement", "evidence", "falsification"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1},
        "falsification": {"type": "string", "minLength": 1}
      }
    },
    "user": {
      "type": "object",
      "required": ["role", "decision_to_make"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "decision_to_make": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "required": ["input", "processing", "output", "out_of_scope"],
      "properties": {
        "input": {"type": "array", "minItems": 1},
        "processing": {"type": "array", "minItems": 1},
        "output": {"type": "array", "minItems": 1},
        "out_of_scope": {"type": "array", "minItems": 1}
      }
    },
    "data": {
      "type": "object",
      "required": ["classification", "local_processing_required", "datasets", "golden_dataset"],
      "properties": {
        "classification": {"enum": ["L1", "L2", "L3"]},
        "local_processing_required": {"type": "boolean"},
        "datasets": {"type": "array", "minItems": 1},
        "golden_dataset": {"type": "string", "minLength": 1}
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["functional", "quality", "abstention", "latency_ms", "cost_per_run_jpy"],
      "properties": {
        "functional": {"type": "array", "minItems": 1},
        "quality": {"type": "array", "minItems": 1},
        "abstention": {"type": "array", "minItems": 1},
        "latency_ms": {"type": ["integer", "null"], "minimum": 0},
        "cost_per_run_jpy": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "technical_decisions": {
      "type": "object",
      "required": ["required_ids", "compatibility_checks", "known_failures", "migration_rules"],
      "properties": {
        "required_ids": {"type": "array", "items": {"type": "string"}},
        "compatibility_checks": {"type": "array", "items": {"type": "string"}},
        "known_failures": {"type": "array", "items": {"type": "string"}},
        "migration_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "quality_gate": {
      "type": "object",
      "required": ["commands", "required_artifacts", "block_on_failure"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "argv", "required"],
            "properties": {
              "name": {"type": "string"},
              "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "required": {"type": "boolean"},
              "timeout_seconds": {"type": "integer", "minimum": 1}
            }
          }
        },
        "required_artifacts": {"type": "array", "items": {"type": "string"}},
        "block_on_failure": {"type": "boolean"}
      }
    },
    "demo": {
      "type": "object",
      "required": ["modes", "reset_argv", "fallback"],
      "properties": {
        "modes": {"type": "array", "items": {"enum": ["live", "replay", "mock"]}},
        "reset_argv": {"type": "array", "items": {"type": "string"}},
        "fallback": {"type": "string"}
      }
    },
    "decision": {
      "type": "object",
      "required": ["pass", "pivot", "kill"],
      "properties": {
        "pass": {"type": "string", "minLength": 1},
        "pivot": {"type": "string", "minLength": 1},
        "kill": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "required": ["status", "evidence", "quality_report"],
      "properties": {
        "status": {"enum": ["not_run", "pass", "pivot", "kill", "blocked"]},
        "evidence": {"type": "array"},
        "quality_report": {"type": "string"}
      }
    }
  },
  "additionalProperties": true
}
